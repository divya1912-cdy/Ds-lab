#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 1000

struct Stack {
    char arr[MAX];
    int top;
};

void init(struct Stack *s) {
    s->top = -1;
}

void push(struct Stack *s, char c) {
    if (s->top == MAX - 1) return;
    s->arr[++(s->top)] = c;
}

char pop(struct Stack *s) {
    if (s->top == -1) return '\0';
    return s->arr[(s->top)--];
}

int isMatching(char open, char close) {
    if (open == '(' && close == ')') return 1;
    if (open == '{' && close == '}') return 1;
    if (open == '[' && close == ']') return 1;
    return 0;
}

int isBalanced(char *expr) {
    struct Stack s;
    init(&s);

    for (int i = 0; expr[i]; i++) {
        char ch = expr[i];

        if (ch == '(' || ch == '{' || ch == '[') {
            push(&s, ch);
        }
        else if (ch == ')' || ch == '}' || ch == ']') {
            char top = pop(&s);
            if (!isMatching(top, ch)) {
                return 0;
            }
        }
    }

    return (s.top == -1);
}

int main() {
    char expr[MAX];

    printf("Enter expression: ");
    scanf("%s", expr);

    if (isBalanced(expr))
        printf("Output: true\n");
    else
        printf("Output: false\n");

    
